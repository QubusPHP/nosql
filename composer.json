{
    "name": "qubus/nosql",
    "description": "PHP JSON flat file Database Management System.",
    "keywords": [
        "json",
        "nosql",
        "schemaless"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Joshua Parker",
            "email": "joshua@joshuaparker.dev"
        }
    ],
    "require": {
        "php": ">=8.4",
        "qubus/exception": "^4",
        "qubus/valueobjects": "^4.0"
    },
    "require-dev": {
        "qubus/qubus-coding-standard": "^2"
    },
    "autoload": {
        "psr-4": {
            "Qubus\\NoSql\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Qubus\\Tests\\NoSql\\": "Tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "cs-check": "phpcs",
        "cs-fix": "phpcbf"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "pestphp/pest-plugin": true
        }
    }
}
